(deflisten username :initial "user" "whoami")
(deflisten playerState :initial "Nothing playing" "playerctl --follow metadata --format {{status}}")
(deflisten song :initial "" "playerctl --follow metadata --format {{title}}")
(deflisten artist :initial "" "playerctl --follow metadata --format {{artist}}")
(deflisten songProgress :initial 0.0 '/home/lars/.config/eww/mediaPosition.sh')
(defpoll bluetoothStatus :interval '5s' :initial "false" 'bluetoothctl show | egrep ".*PowerState.*" | sed "s|.*PowerState: ||"')
(deflisten coverArt :initial ""
    "/home/lars/.config/eww/coverart.sh"
)
(deflisten btDevices :initial "[]" "/home/lars/.config/eww/bluetoothDevices.sh")
(defpoll timer :interval '60s' :initial 0.0 "python /home/lars/.config/eww/pauseTimer.py")



(defwindow dashboard 
	:monitor "DP-1"
	:stacking "overlay"
	:wm-ignore true
(container))

(defwidget container[]
	(box 
		:class "main"
		:orientation "horizontal"
		:valign "center"
		:halign "center"
		:spacing 10
		:width 1400
		:height 840
		:hexpand false
         	:vexpand false
		:space-evenly false
		(box
			:class "columnOne"
			:orientation "vertical"
			:space-evenly false
			:spacing 10
			(box 
				:class "card"
				:spacing 10
				:orientation "vertical"
				:vexpand true
				:space-evenly false
				(box :class "profile")
				(label :class "profileText" :text username)
			)
			(box
				:class "card mediaCard"
				:spacing 10
				:orientation "vertical"
				:space-evenly false
				(box :orientation "vertical"
				    	:class "player"
				    	:style {playerState == "Playing" || playerState == "Paused"? "background: url('${coverArt}');background-repeat: no-repeat;background-size: 500px;background-position: center;" : "background-color: rgba(35, 41, 46, 0.95);"}
					(stack
					    :selected {playerState == "Playing" || playerState == "Paused" ? 0 : 1}
					    (box
					    	:orientation "vertical"
						(label :text song :class "song")
						(label :text artist :class "artist")
						(progress
							:orientation "horizontal"
							:value songProgress
						)

					    )
					    (label :text "Nothing playing")
					)
				)
				(box
					:orientation "horizontal"
					:class "media-controls"
					(button
						:onlick "playerctl previous"
						(label :text "<<")
					)
					(stack
						:selected {playerState != "Playing" ? 0 : 1}
						(button
							:onclick "playerctl play"
							(label :text "▶")
						)
						(button
							:onclick "playerctl pause"
							(label :text "||")
						)
					)
					(button
						:onlick "playerctl next"
						(label :text ">>")
					)
				)
			)
		)
		(box
			:class "columnTwo"
			:orientation "vertical"
			:space-evenly false
			:spacing 10
			(box
				:class "card bluetoothCard"
				:orientation "vertical"
				:vexpand true
				:space-evenly false
				(button
					:class "bluetoothBtn"
					:onclick {bluetoothStatus == "off" ? "bluetoothctl power on" : "bluetoothctl power off"}
					(image
						:path {bluetoothStatus == "off"? "/home/lars/.config/eww/icons8-bluetooth-96.png" : "/home/lars/.config/eww/icons8-bluetooth-96-on.png" }
						:image-width 192
						:image-height 192
						;<a target="_blank" href="https://icons8.com/icon/9932/bluetooth">Bluetooth</a> icon by <a target="_blank" href="https://icons8.com">Icons8</a>
					)
				)
				(box :orientation "vertical"
					(label :text "Connected devices" :class "devicesHeader")
					(for device in btDevices
						(label :text {device["name"]})
					)
				)
			)
		)
		(box
			:class "card columnThree"
			:orientation "vertical"
			(progress
				:class "timer"
				:value timer
				:orientation "v"
				:flipped true
			)
		)
		(box
			:class "buttons"
			:spacing 10
			:orientation "vertical"
			(button
				:onclick "loginctl poweroff"
				:class "powerOff"
				(label :text "⏻")
			)
			(button
				:onclick "loginctl reboot"
				:class "reboot"
				(label :text "⟳")
			)
			(button
				:onclick "niri msg action quit"
				:class "logout"
				(label :text "➜]")
			)
			(button
				:onclick "loginctl suspend"
				:class "sleep"
				(label :text "⏾")
			)
		)

		
	)
)
